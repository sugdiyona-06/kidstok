# Supabase → Project Settings → API bo'limidan oling
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # anon (yoki publishable) kalit — brauzerga beriladi
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # service_role (yoki secret) kalit — FAQAT serverda, hech kimga ko'rsatmang!

# Ixtiyoriy: Pro obunani qayerdan olish mumkinligi (masalan, Telegram havolasi)
PRO_CONTACT_URL=

# ---- Online to'lov (ixtiyoriy). Kalitlar bo'sh bo'lsa, to'lov tugmalari ko'rinmaydi ----
# Obuna narxlari, so'mda (bo'sh qoldirsangiz: 29000 / 79000 / 249000)
PRICE_30=
PRICE_90=
PRICE_365=
# Sayt manzili (Render'da: https://kidstok.onrender.com). Bo'sh bo'lsa, o'zi aniqlanadi
SITE_URL=
# Payme (Payme Business kabinetidan)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=false
# Click (Click Merchant kabinetidan)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# So'rovlar limiti (15 daqiqada bitta foydalanuvchiga), standart 1200
RATE_LIMIT_MAX=

PORT=3000
NODE_ENV=development
